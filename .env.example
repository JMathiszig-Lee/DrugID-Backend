# Copy this file to .env for local Docker use. Never commit the real .env.
# Generate a production key with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=replace-this-with-a-long-random-production-secret
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://localhost:5173
PUBLIC_APP_URL=http://localhost:8000

# Compose database. Keep DATABASE_URL and the POSTGRES_* values in sync.
POSTGRES_DB=drugid
POSTGRES_USER=drugid
POSTGRES_PASSWORD=replace-this-database-password
DATABASE_URL=postgresql://drugid:replace-this-database-password@db:5432/drugid

# Local development prints magic links to the web container logs. In production,
# use django.core.mail.backends.smtp.EmailBackend and configure the SMTP values.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
DEFAULT_FROM_EMAIL="Ampoule Study <no-reply@example.com>"

MAGIC_LINK_TTL_SECONDS=900
MAGIC_LINK_RATE=5/h
MAGIC_LINK_EMAIL_LIMIT=3
MAGIC_LINK_EMAIL_WINDOW_SECONDS=3600
# Never expose a bearer link in an API response outside deliberate local development.
SHOW_DEBUG_MAGIC_LINK=False

# Magic-link sessions expire after four hours and when the browser closes. Participants can
# request another link to resume their server-side progress.
SESSION_COOKIE_AGE=14400
SESSION_EXPIRE_AT_BROWSER_CLOSE=True

# These HTTP settings are appropriate for plain-http localhost only. Production
# must terminate HTTPS and set the three booleans to True. Enable HSTS only after
# HTTPS is working correctly for the production domain.
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_SSL_REDIRECT=False
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False

APP_PORT=8000
GUNICORN_WORKERS=2
GUNICORN_THREADS=2
GUNICORN_TIMEOUT=30
GUNICORN_GRACEFUL_TIMEOUT=30
GUNICORN_KEEPALIVE=5
RUN_MIGRATIONS=1
LOAD_STUDY_ASSETS=1
